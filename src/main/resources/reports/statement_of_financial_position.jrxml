<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="StatementOfFinancialPosition"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="ReportTitle" class="java.lang.String"/>
    <parameter name="AsOfDate" class="java.lang.String"/>

    <field name="section" class="java.lang.String"/>
    <field name="line" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>

    <title>
        <band height="50">
            <textField>
                <reportElement x="0" y="0" width="550" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{ReportTitle}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="20" width="550" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["As of " + $P{AsOfDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="120" height="20"/>
                <text><![CDATA[Section]]></text>
            </staticText>

            <staticText>
                <reportElement x="120" y="0" width="300" height="20"/>
                <text><![CDATA[Line]]></text>
            </staticText>

            <staticText>
                <reportElement x="420" y="0" width="130" height="20"/>
                <text><![CDATA[Amount]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{section}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="120" y="0" width="300" height="20"/>
                <textFieldExpression><![CDATA[$F{line}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="420" y="0" width="130" height="20"/>
                <textFieldExpression><![CDATA[$F{amount}.toString()]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>