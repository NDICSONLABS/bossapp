<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="AgingReport"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="ReportTitle" class="java.lang.String"/>
    <parameter name="AsOfDate" class="java.lang.String"/>

    <field name="entityName" class="java.lang.String"/>
    <field name="reference" class="java.lang.String"/>
    <field name="dueDate" class="java.lang.String"/>
    <field name="originalAmount" class="java.math.BigDecimal"/>
    <field name="paidAmount" class="java.math.BigDecimal"/>
    <field name="outstandingAmount" class="java.math.BigDecimal"/>
    <field name="overdueDays" class="java.lang.Long"/>
    <field name="agingBucket" class="java.lang.String"/>

    <title>
        <band height="50">
            <textField>
                <reportElement x="0" y="0" width="800" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{ReportTitle}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="20" width="800" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["As of " + $P{AsOfDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="120" height="20"/>
                <text><![CDATA[Entity]]></text>
            </staticText>

            <staticText>
                <reportElement x="120" y="0" width="100" height="20"/>
                <text><![CDATA[Reference]]></text>
            </staticText>

            <staticText>
                <reportElement x="220" y="0" width="80" height="20"/>
                <text><![CDATA[Due Date]]></text>
            </staticText>

            <staticText>
                <reportElement x="300" y="0" width="90" height="20"/>
                <text><![CDATA[Original]]></text>
            </staticText>

            <staticText>
                <reportElement x="390" y="0" width="90" height="20"/>
                <text><![CDATA[Paid]]></text>
            </staticText>

            <staticText>
                <reportElement x="480" y="0" width="100" height="20"/>
                <text><![CDATA[Outstanding]]></text>
            </staticText>

            <staticText>
                <reportElement x="580" y="0" width="70" height="20"/>
                <text><![CDATA[Overdue Days]]></text>
            </staticText>

            <staticText>
                <reportElement x="650" y="0" width="80" height="20"/>
                <text><![CDATA[Bucket]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{entityName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="120" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="220" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{dueDate}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="300" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{originalAmount}.toString()]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="390" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{paidAmount}.toString()]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="480" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{outstandingAmount}.toString()]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="580" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{overdueDays}.toString()]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="650" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{agingBucket}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>